<mxCell id="c33" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Đặt kiểm tra thành giai đoạn&lt;br&gt;riêng và cho nó vòng sửa lỗi,&lt;br&gt;thay vì kiểm tra một lần ở&lt;br&gt;cuối.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="1981" width="340" height="136" as="geometry"/></mxCell>
