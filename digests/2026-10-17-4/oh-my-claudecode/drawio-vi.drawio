<mxCell id="c5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;AI&lt;/div&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFC83D;strokeColor=none;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="71" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;oh-my-claudecode: cả đội agent chạy ngay&lt;br&gt;trong Claude Code&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Một lệnh /team để Claude Code chia việc, kiểm tra và sửa lỗi theo vòng, thay vì một agent&lt;br&gt;làm hết.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="68" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Các mảnh ghép&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Plugin trong&lt;br&gt;Claude Code&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Đưa các skill /team,&lt;br&gt;/autopilot, /ralph&lt;br&gt;vào phiên Claude&lt;br&gt;Code qua&lt;br&gt;marketplace của&lt;br&gt;plugin.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="280" height="266" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c9"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Lệnh omc (gói&lt;br&gt;npm)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Lệnh terminal: omc&lt;br&gt;setup, omc team, omc&lt;br&gt;ask. Cài bằng gói npm&lt;br&gt;oh-my-claude-sisyph&lt;br&gt;us.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="530" width="280" height="266" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c11"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Đội native&lt;br&gt;(/team)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Các agent Claude&lt;br&gt;phối hợp trên một&lt;br&gt;danh sách việc&lt;br&gt;chung; cần bật cờ&lt;br&gt;đội native trong&lt;br&gt;settings.json (bước&lt;br&gt;4).&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="530" width="280" height="266" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c13"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Worker tmux&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Pane tmux chạy CLI&lt;br&gt;thật (claude, codex,&lt;br&gt;gemini, antigravity,&lt;br&gt;grok,&lt;br&gt;cursor-agent); sinh&lt;br&gt;khi cần, tắt khi&lt;br&gt;xong.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="280" height="239" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c15"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Thư mục .omc/&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Nơi OMC giữ trạng&lt;br&gt;thái chạy, dữ liệu&lt;br&gt;phiên, kế hoạch và&lt;br&gt;log của dự án.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="870" width="280" height="239" as="geometry"/></mxCell>
<mxCell id="c18" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c17"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1191" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Hai lối vào, hai runtime&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Lệnh /team trong phiên Claude Code chạy đội&lt;br&gt;native; omc team ở terminal mở worker CLI thật&lt;br&gt;trong tmux. README nói rõ đây là hai runtime&lt;br&gt;khác nhau.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1257" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c21" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c20"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Chuỗi giai đoạn có vòng sửa&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Team chạy team-plan → team-prd → team-exec →&lt;br&gt;team-verify → team-fix (loop): kiểm tra là một&lt;br&gt;giai đoạn riêng, và lỗi được sửa lặp lại.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1257" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c23" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c22"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Worker sinh khi cần, tắt khi xong&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Worker của omc team được sinh theo yêu cầu và&lt;br&gt;chết khi xong việc, nên README nói không tốn&lt;br&gt;tài nguyên lúc nhàn rỗi.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1457" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c25" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c24"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Mỗi phiên một người cầm vòng lặp&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;README dặn dùng một quyền điều khiển vòng lặp&lt;br&gt;chính mỗi phiên: Team cho việc song song theo&lt;br&gt;giai đoạn, Execute cho một agent làm tới nơi,&lt;br&gt;Verify cho vòng kiểm tra lặp.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1457" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c27" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c26"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Trạng thái nằm trong .omc/&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;OMC ghi trạng thái, phiên, kế hoạch vào thư mục&lt;br&gt;.omc/. Trong worktree liên kết, thư mục này&lt;br&gt;nằm trong worktree nên xóa worktree là mất;&lt;br&gt;đặt OMC_STATE_DIR để giữ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1657" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c29" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c28"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Học được gì từ thiết kế này&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1915" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Tách hai runtime: đội chạy&lt;br&gt;trong phiên và worker chạy&lt;br&gt;ngoài phiên, mỗi bên hợp một&lt;br&gt;loại việc.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1981" width="340" height="136" as="geometry"/></mxCell>
