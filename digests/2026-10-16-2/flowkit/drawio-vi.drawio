<mxCell id="c5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;AI&lt;/div&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFC83D;strokeColor=none;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="71" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;FlowKit: Cầu nối tự động hoá tạo video AI&lt;br&gt;từ Google Flow&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Làm sao gọi API của một dịch vụ web không có REST API mở và bắt buộc phải đăng nhập&lt;br&gt;trên trình duyệt?&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="68" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Các mảnh ghép&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Python Agent&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Dịch vụ FastAPI và&lt;br&gt;SQLite quản lý hàng&lt;br&gt;đợi, xử lý hậu kỳ và&lt;br&gt;điều phối dữ liệu qua&lt;br&gt;WebSocket.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="502" width="280" height="244" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c9"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Chrome&lt;br&gt;Extension&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Service worker đóng&lt;br&gt;vai trò cầu nối, lấy&lt;br&gt;token reCAPTCHA&lt;br&gt;và thực thi RPC&lt;br&gt;trực tiếp trong ngữ&lt;br&gt;cảnh trang.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="502" width="280" height="244" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c11"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Trình duyệt&lt;br&gt;mở sẵn&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Tab trình duyệt giữ&lt;br&gt;phiên đăng nhập hợp&lt;br&gt;lệ với cookie và&lt;br&gt;token bảo mật cần&lt;br&gt;thiết để ký RPC.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="502" width="280" height="244" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c13"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="828" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Tiếp nhận tác vụ&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Python agent tiếp nhận kịch bản, xử lý logic&lt;br&gt;hàng đợi và gửi dữ liệu yêu cầu sang Chrome&lt;br&gt;extension thông qua kết nối WebSocket nội bộ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="894" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c17" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c16"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Xác thực và ký RPC&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Chrome extension hoạt động ngay trong tab&lt;br&gt;dịch vụ, tự lấy token reCAPTCHA, gắn cookie&lt;br&gt;phiên và gửi batchexecute RPC hợp lệ tới máy&lt;br&gt;chủ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="894" width="520" height="176" as="geometry"/></mxCell>
