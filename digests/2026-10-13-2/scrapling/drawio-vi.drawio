<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Adaptive&lt;br&gt;Parser&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Bộ phân tích dữ liệu&lt;br&gt;có khả năng ghi nhớ&lt;br&gt;và tự tái định vị&lt;br&gt;phần tử khi cấu trúc&lt;br&gt;HTML thay đổi.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="496" width="280" height="221" as="geometry"/></mxCell>
