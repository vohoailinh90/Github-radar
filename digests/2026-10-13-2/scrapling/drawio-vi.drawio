<mxCell id="c15" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="799" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Gửi request ngầm&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;StealthyFetcher thực hiện tải website ở chế&lt;br&gt;độ headless và network idle để vượt qua các bộ&lt;br&gt;lọc bot như Cloudflare Turnstile.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="865" width="520" height="152" as="geometry"/></mxCell>
<mxCell id="c17" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c16"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Bóc tách tự thích ứng&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Khi chọn phần tử với auto_save=True, parser&lt;br&gt;lưu lại đặc điểm; khi trang đổi layout, cờ&lt;br&gt;adaptive=True giúp tự tìm lại phần tử đó.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="865" width="520" height="152" as="geometry"/></mxCell>
