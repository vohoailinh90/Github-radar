<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;PRODUCT.md&lt;br&gt;và DESIGN.md&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;PRODUCT.md giữ sự&lt;br&gt;thật bền của sản&lt;br&gt;phẩm; DESIGN.md ghi&lt;br&gt;riêng hệ thống thị&lt;br&gt;giác.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="496" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c11"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Engine và&lt;br&gt;launcher&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Binary tự chứa chạy&lt;br&gt;cạnh launcher, hoặc&lt;br&gt;được tải một lần vào&lt;br&gt;~/.impeccable/bin/.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="496" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c13"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Bộ dò&lt;br&gt;(detector)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;59 quy tắc xác định,&lt;br&gt;chạy bằng CLI hoặc&lt;br&gt;tiện ích trình&lt;br&gt;duyệt, không cần&lt;br&gt;LLM hay khóa API.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="791" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c15"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Hook thiết kế&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Chạy detector khi&lt;br&gt;agent sửa file giao&lt;br&gt;diện và đưa phát&lt;br&gt;hiện về luồng của&lt;br&gt;agent.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="791" width="280" height="221" as="geometry"/></mxCell>
