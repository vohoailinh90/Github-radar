<mxCell id="c39" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Nói rõ giới hạn của công cụ&lt;br&gt;kiểm tra: README viết rằng&lt;br&gt;lần quét sạch chỉ là bằng&lt;br&gt;chứng, không thay việc xem&lt;br&gt;giao diện thật.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2137" width="340" height="159" as="geometry"/></mxCell>
