<mxCell id="c32" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Học được gì từ thiết kế này&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1864" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Đặt tên cho từng việc: 24&lt;br&gt;lệnh như polish, quieter,&lt;br&gt;distill tạo từ vựng chung&lt;br&gt;giữa người và AI, nên yêu&lt;br&gt;cầu ngắn mà vẫn rõ.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1930" width="340" height="183" as="geometry"/></mxCell>
