<rectangle x="60" y="1126" width="520" height="170" fill="#CFF5EE" stroke="#0B1B3A" stroke-width="3" corner-radius="24"/>
<rectangle x="82" y="1148" width="56" height="56" corner-radius="full" fill="#0B1B3A" text="1" font-size="28" font-weight="800" color="#FFFFFF"/>
<text x="154" y="1148" width="404" height="28" font-size="22" font-weight="800" color="#1F2A44" text-align="left" line-height="1.25">Cài skill vào công cụ AI</text>
<text x="154" y="1184" width="404" height="90" font-size="16" font-weight="400" color="#1F2A44" text-align="left" line-height="1.4">npx impeccable install đặt skill, và hook cho Claude Code, Copilot, Codex, Cursor, Grok Build, vào thư mục của từng công cụ. Launcher trong scripts chạy engine.</text>
<line x1="584" y1="1211" x2="616" y2="1211" stroke="#FF6B4A" stroke-width="5" arrow-end="triangle" pointer-length="14" pointer-width="14"/>
