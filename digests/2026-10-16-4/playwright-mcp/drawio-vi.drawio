<mxCell id="c4" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FF6B4A;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="328" width="1200" height="10" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;AI&lt;/div&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFC83D;strokeColor=none;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="71" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;Playwright MCP: cho AI agent tự điều&lt;br&gt;khiển trình duyệt&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Agent AI đọc trang web bằng cấu trúc thay vì ảnh chụp, nên không cần mô hình xử lý hình&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="34" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Các mảnh ghép&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="402" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;MCP client&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Ứng dụng AI của bạn&lt;br&gt;(VS Code, Cursor,&lt;br&gt;Claude Desktop...),&lt;br&gt;nơi khai báo máy chủ&lt;br&gt;và nơi agent gọi&lt;br&gt;công cụ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="280" height="272" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c9"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Máy chủ&lt;br&gt;Playwright&lt;br&gt;MCP&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Tiến trình chạy&lt;br&gt;bằng npx&lt;br&gt;@playwright/mcp@lat&lt;br&gt;est, nhận lời gọi&lt;br&gt;công cụ và điều&lt;br&gt;khiển trình duyệt.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="468" width="280" height="272" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c11"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Trình duyệt&lt;br&gt;do Playwright&lt;br&gt;mở&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Chromium, Firefox,&lt;br&gt;WebKit hoặc kênh&lt;br&gt;Chrome, Edge; chạy&lt;br&gt;headless hoặc có cửa&lt;br&gt;sổ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="468" width="280" height="272" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c13"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Accessibility&lt;br&gt;snapshot&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Cây cấu trúc của&lt;br&gt;trang kèm tham chiếu&lt;br&gt;phần tử; thứ agent&lt;br&gt;đọc thay cho ảnh&lt;br&gt;chụp.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="814" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c15"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Bộ công cụ&lt;br&gt;(tools)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Nhóm cốt lõi (điều&lt;br&gt;hướng, bấm, gõ,&lt;br&gt;snapshot), quản lý&lt;br&gt;tab và các nhóm bật&lt;br&gt;bằng --caps.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="814" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c18" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c17"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Hồ sơ và cấu&lt;br&gt;hình&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Tham số args, biến&lt;br&gt;môi trường hoặc file&lt;br&gt;JSON; hồ sơ lưu bền,&lt;br&gt;isolated hoặc&lt;br&gt;extension.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="814" width="280" height="221" as="geometry"/></mxCell>
<mxCell id="c20" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="c19"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1117" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Client gọi công cụ&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;MCP client khởi chạy máy chủ bằng npx&lt;br&gt;@playwright/mcp@latest rồi gọi các công cụ như&lt;br&gt;browser_navigate hay browser_click.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1183" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c23" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c22"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Máy chủ điều khiển trình duyệt&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Máy chủ dùng Playwright mở Chromium, Firefox,&lt;br&gt;WebKit hoặc kênh Chrome, Edge; hồ sơ có thể&lt;br&gt;lưu bền, isolated hoặc nối vào trình duyệt đang&lt;br&gt;chạy.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1183" width="520" height="176" as="geometry"/></mxCell>
<mxCell id="c25" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c24"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Snapshot thay vì ảnh chụp&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;browser_snapshot trả cây accessibility của&lt;br&gt;trang. Ảnh chụp màn hình chỉ để xem: README&lt;br&gt;nói không thể hành động dựa trên ảnh, hãy dùng&lt;br&gt;snapshot.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1383" width="520" height="199" as="geometry"/></mxCell>
<mxCell id="c27" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c26"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Chọn phần tử theo tham chiếu&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Công cụ thao tác như bấm, gõ nhận target là&lt;br&gt;tham chiếu chính xác lấy từ snapshot hoặc một&lt;br&gt;selector duy nhất (kéo thả có điểm đầu và điểm&lt;br&gt;cuối). README nói cách này tránh sự mơ hồ của&lt;br&gt;cách dựa trên ảnh chụp.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1383" width="520" height="199" as="geometry"/></mxCell>
<mxCell id="c29" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c28"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Nhóm công cụ mở rộng&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Ngoài nhóm cốt lõi và quản lý tab, các nhóm&lt;br&gt;mạng, lưu trữ, devtools, vision, pdf và kiểm thử&lt;br&gt;được bật thêm bằng --caps.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1606" width="520" height="152" as="geometry"/></mxCell>
<mxCell id="c31" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c30"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Học được gì từ thiết kế này&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1840" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Đưa cho mô hình dữ liệu có cấu trúc thay vì ảnh:&lt;br&gt;ít mơ hồ hơn và không cần mô hình xem ảnh&lt;br&gt;(README gọi là áp dụng công cụ có tính xác định).&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1906" width="525" height="112" as="geometry"/></mxCell>
<mxCell id="c34" style="html=1;endArrow=none;strokeColor=#FFC83D;strokeWidth=5;" edge="1" parent="c33"><mxGeometry relative="1" as="geometry"><mxPoint x="30.8" y="40.8" as="sourcePoint"/><mxPoint x="50" y="32.8" as="targetPoint"/><Array as="points"><mxPoint x="37.6" y="48"/></Array></mxGeometry></mxCell>
<mxCell id="c35" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Chia khả năng thành nhóm bật thêm theo nhu cầu&lt;br&gt;(`--caps`): nhóm cốt lõi có sẵn, các nhóm mạng, lưu&lt;br&gt;trữ, devtools bật riêng.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="615" y="1906" width="525" height="112" as="geometry"/></mxCell>
<mxCell id="c36" style="html=1;endArrow=none;strokeColor=#FFC83D;strokeWidth=5;" edge="1" parent="c35"><mxGeometry relative="1" as="geometry"><mxPoint x="30.8" y="40.8" as="sourcePoint"/><mxPoint x="50" y="32.8" as="targetPoint"/><Array as="points"><mxPoint x="37.6" y="48"/></Array></mxGeometry></mxCell>
<mxCell id="c37" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Một lõi, nhiều cách nối: stdio qua `npx`, HTTP qua&lt;br&gt;`--port`, Docker, hoặc nhúng bằng&lt;br&gt;`createConnection`: README liệt kê cả bốn cách&lt;br&gt;chạy.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2042" width="525" height="136" as="geometry"/></mxCell>
<mxCell id="c38" style="html=1;endArrow=none;strokeColor=#FFC83D;strokeWidth=5;" edge="1" parent="c37"><mxGeometry relative="1" as="geometry"><mxPoint x="30.8" y="40.8" as="sourcePoint"/><mxPoint x="50" y="32.8" as="targetPoint"/><Array as="points"><mxPoint x="37.6" y="48"/></Array></mxGeometry></mxCell>
<mxCell id="c39" value="&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#FFFFFF&quot;&gt;Nói rõ giới hạn của mình: README phân biệt MCP&lt;br&gt;với CLI kèm SKILLS và nhắc đây không phải ranh&lt;br&gt;giới bảo mật, giúp người dùng chọn đúng công cụ.&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#0B1B3A;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=20;spacingLeft=76;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="615" y="2042" width="525" height="136" as="geometry"/></mxCell>
