<mxCell id="c13" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Thư mục tài&lt;br&gt;nguyên&lt;br&gt;(public/)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Lưu trữ hình ảnh,&lt;br&gt;font chữ, video&lt;br&gt;trích xuất từ&lt;br&gt;website nguồn theo&lt;br&gt;từng thư mục site&lt;br&gt;riêng biệt.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="530" width="280" height="272" as="geometry"/></mxCell>
