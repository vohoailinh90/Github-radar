<mxCell id="c5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;AI&lt;/div&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFC83D;strokeColor=none;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="71" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;Tạo video ngắn từ một chủ đề với&lt;br&gt;MoneyPrinterTurbo&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Gõ một chủ đề, máy tự viết kịch bản, đọc lời, thêm phụ đề rồi ghép thành video&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="34" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Các mảnh ghép&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="402" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Mô hình ngôn ngữ&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Viết hoặc viết lại kịch bản video.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="480" height="105" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Nguồn clip&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Cung cấp clip nền: kho miễn phí hoặc tệp của bạn.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="468" width="480" height="105" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Giọng đọc và phụ đề&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Biến kịch bản thành tiếng và dòng chữ chạy theo&lt;br&gt;tiếng.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="647" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Bộ dựng video&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Ghép clip, giọng, chữ và nhạc thành video; ffmpeg&lt;br&gt;thường tự tải về.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="647" width="480" height="127" as="geometry"/></mxCell>
