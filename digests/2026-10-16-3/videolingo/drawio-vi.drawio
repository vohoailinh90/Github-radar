<mxCell id="c5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;AI&lt;/div&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFC83D;strokeColor=none;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="71" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;Làm phụ đề và lồng tiếng cho video với&lt;br&gt;VideoLingo&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Đưa một video vào, nhận phụ đề đã dịch và có thể cả bản lồng tiếng bằng ngôn ngữ khác&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="34" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Các mảnh ghép&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="402" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Giao diện Streamlit&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Nơi nhập cấu hình, đưa video vào và điều khiển từng&lt;br&gt;bước.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Nhận dạng giọng nói&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Chép lời có mốc thời gian từng từ; mặc định chạy cục&lt;br&gt;bộ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="468" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Mô hình dịch (LLM)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Cắt, dịch và viết lại phụ đề qua API tương thích&lt;br&gt;OpenAI.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="669" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Lồng tiếng (TTS)&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Đọc bản dịch bằng GPT-SoVITS, OpenAI, Edge TTS và&lt;br&gt;các dịch vụ khác.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="669" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Lấy video và nhận dạng giọng nói&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Tải video qua yt-dlp nếu cần, rồi nhận dạng lời&lt;br&gt;ở mức từng từ bằng Qwen3-ASR và&lt;br&gt;ForcedAligner.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="944" width="520" height="152" as="geometry"/></mxCell>
<mxCell id="c15" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c14"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Cắt phụ đề&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Dùng xử lý ngôn ngữ và AI để chia phụ đề, với&lt;br&gt;giới hạn độ dài chỉnh được.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="944" width="520" height="152" as="geometry"/></mxCell>
<mxCell id="c17" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c16"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Dịch có thuật ngữ&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Dịch trực tiếp, tùy chọn phản tư và viết lại tự&lt;br&gt;nhiên, dựa trên thuật ngữ tùy chỉnh và thuật&lt;br&gt;ngữ do AI tạo.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF0B8;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="520" height="152" as="geometry"/></mxCell>
<mxCell id="c19" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#0B1B3A;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c18"><mxGeometry x="22" y="22" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Lồng tiếng và ghép&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Dịch vụ TTS đọc bản dịch, rồi xuất phụ đề và&lt;br&gt;video có phụ đề hoặc lồng tiếng.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1120" width="520" height="152" as="geometry"/></mxCell>
