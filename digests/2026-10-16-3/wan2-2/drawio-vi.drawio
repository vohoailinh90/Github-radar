<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Câu mô tả và ảnh&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Đầu vào do bạn đưa: một câu mô tả, có thể kèm ảnh.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="480" height="127" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Mở rộng mô tả&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Tùy chọn: viết lại câu mô tả chi tiết hơn bằng&lt;br&gt;Dashscope hoặc Qwen cục bộ.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=20;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="468" width="480" height="127" as="geometry"/></mxCell>
