<mxCell id="c20" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Tái cấu trúc bằng Copilot CLI&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Sử dụng Copilot CLI và mô hình AI để chuyển&lt;br&gt;hành động thô thành ý định tổng quát và các&lt;br&gt;bước làm việc logic theo thứ tự.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="967" width="520" height="152" as="geometry"/></mxCell>
