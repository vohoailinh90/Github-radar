<mxCell id="c11" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;GitHub Copilot CLI&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Thành phần CLI nhúng sẵn phụ trách xác&lt;br&gt;thực GitHub OAuth và kết nối bộ SDK.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFD9CF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="468" width="480" height="127" as="geometry"/></mxCell>
