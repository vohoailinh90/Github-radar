<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Biến ChatGPT trên trình duyệt thành trợ lý lập trình cục bộ với MCP và quy trình đa&lt;br&gt;agent.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="68" as="geometry"/></mxCell>
