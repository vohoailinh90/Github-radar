<mxCell id="c24" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Kiểm soát phiên dài&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Goal theo dõi việc dở dang, Loop duy trì chỉ&lt;br&gt;dẫn và Compact &amp;amp; Resume chuyển phiên sang&lt;br&gt;chat mới khi đầy.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DDE8FF;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="1154" width="520" height="152" as="geometry"/></mxCell>
