<mxCell id="c18" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Cung cấp công cụ MCP cục bộ&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;CoS hoạt động như máy chủ MCP cục bộ, cho&lt;br&gt;phép ChatGPT đọc sửa tệp, mở terminal và&lt;br&gt;tương tác desktop.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="978" width="520" height="152" as="geometry"/></mxCell>
