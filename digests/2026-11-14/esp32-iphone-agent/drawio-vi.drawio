<mxCell id="c6" value="&lt;div style=&quot;font-size:50px;font-weight:bold;line-height:1.2;color:#FFFFFF&quot;&gt;ESP32 iPhone Agent: Điều khiển iPhone&lt;br&gt;bằng AI qua bo mạch $7&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=50;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="1080" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-size:24px;font-weight:normal;line-height:1.4;color:#BFD0F0&quot;&gt;Để AI nhìn màn hình iPhone, bấm, vuốt và goz hộ bạn qua bo mạch ESP32 giá 7 USD mà&lt;br&gt;không cần jailbreak.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#BFD0F0;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="1080" height="68" as="geometry"/></mxCell>
