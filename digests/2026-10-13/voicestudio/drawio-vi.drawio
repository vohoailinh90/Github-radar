<mxCell id="c9" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Electron UI&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:10px&quot;&gt;Giao diện máy tính&lt;br&gt;để bàn cung cấp các&lt;br&gt;không gian làm việc&lt;br&gt;cho nhân bản giọng,&lt;br&gt;lồng tiếng và quản lý&lt;br&gt;mô hình.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=92;spacingRight=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="502" width="280" height="221" as="geometry"/></mxCell>
