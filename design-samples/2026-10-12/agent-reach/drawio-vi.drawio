<mxCell id="c38" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Ghi thông tin hướng dẫn vào tập tin kỹ năng để&lt;br&gt;AI Agent tự gọi trực tiếp các công cụ dòng&lt;br&gt;lệnh mà không cần qua tầng bọc trung gian.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Helvetica;fontSize=17;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="154" y="1258" width="404" height="72" as="geometry"/></mxCell>
