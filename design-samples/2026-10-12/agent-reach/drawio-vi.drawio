<mxCell id="c17" value="&lt;div style=&quot;font-size:34px;font-weight:bold;line-height:1.4;color:#0B1B3A&quot;&gt;Nó chạy như thế nào&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#0B1B3A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="1080" height="48" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25;color:#1F2A44&quot;&gt;Kiểm tra an toàn&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:normal;line-height:1.4;color:#1F2A44;margin-top:8px&quot;&gt;Lệnh cài đặt mặc định chỉ kiểm tra môi trường&lt;br&gt;hệ thống như Node.js hay gh CLI, chỉ ghi file&lt;br&gt;và cài gói khi có cờ ủy quyền cụ thể.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#CFF5EE;strokeColor=#0B1B3A;strokeWidth=3;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=22;spacingLeft=94;spacingRight=22;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1024" width="520" height="152" as="geometry"/></mxCell>
